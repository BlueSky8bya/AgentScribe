# [PROPOSAL: docs/proposals/archive/2026-06-09/proposal_phase3c1_multiprovider_foundation_v001.md section 7]
# Copy to .env (gitignored; .env.example is kept via !.env.example exception).
# All provider keys live ONLY on the server. Never expose any key to the browser,
# never use a VITE_ prefix for them. Set only the providers you use; others stay
# unavailable (greyed out) in the UI.
#
# IMPORTANT: put REAL keys in .env (gitignored), NOT here. This template stays empty.

# Live provider (Phase 3C-1)
OPENAI_API_KEY=

# Prepared providers (mock/experimental until Phase 3C-2 live rollout + canary)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Dev-only: run a gated-live provider canary (Phase 3C-2b). NEVER set in prod.
# ALLOW_GATED_LIVE_CANARY=1

# Dev-only: allow selecting mock providers for real generation (NEVER set in prod)
# ALLOW_MOCK_PROVIDERS=1

# Optional: backend port (default 8787)
# PORT=8787
