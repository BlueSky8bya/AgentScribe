# AgentScribe QA Engine - LLM API Keys
# Copy this file to .env and fill in your key(s).
# Do NOT commit the real .env file.

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Which model the QA agent uses (DSPy LM string).
# Examples: openai/gpt-4o-mini  |  anthropic/claude-sonnet-4-6
QA_MODEL=openai/gpt-4o-mini
